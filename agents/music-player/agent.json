{
    "id": "com.wenzhoujike.k1.music",
    "version": "1.1.3",
    "description": "Music player for Booster K1: online mp3 URL / local playlist, play modes, seek, system volume.",
    "logo": "/res/logo.png",
    "entry": "src/main.py:MusicPlayerAgent",
    "debuggable": true,
    "gait": "default",
    "requirements": {
        "models": [
            "Booster K1"
        ],
        "min_api_level": 10700,
        "nvidia_jetpack_main_versions": [],
        "qti_qnn_main_versions": [],
        "compile_api_level": 10800,
        "platforms": [
            "sim_x86_64",
            "sim_aarch64",
            "real_jetson",
            "real_qcom"
        ]
    },
    "package_type": "python",
    "ros2": {
        "package_name": "com_wenzhoujike_k1_music",
        "launch_file": "launch.py"
    },
    "locale_name": {
        "en": "Music Player",
        "zh": "音乐播放器"
    },
    "app_image": {
        "icon": "/res/logo.png"
    }
}